# aistudio-api 环境变量配置
# 复制此文件为 .env 并按需修改

# ========== 服务基础配置 ==========
# HTTP 服务监听端口
AISTUDIO_PORT=8080
# Web 管理控制台访问密码（设置后访问 / 自动启用登录拦截）
AISTUDIO_WEB_PASSWORD=
# AISTUDIO_ADMIN_PASSWORD=

# ========== 浏览器运行时 ==========
# Chromium 远程调试端口 (CDP)
AISTUDIO_BROWSER_PORT=9222
# 浏览器无头模式（1=无头，0=有头调试）
AISTUDIO_BROWSER_HEADLESS=1
# Chromium 可执行文件绝对路径（留空自动探测系统安装的 Chrome/Chromium）
AISTUDIO_BROWSER_EXECUTABLE=

# ========== 网络代理与凭据 ==========
# HTTP / SOCKS5 出口代理（如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080）
AISTUDIO_PROXY=
# 账号凭据存储目录（留空默认使用 data/accounts）
AISTUDIO_ACCOUNTS_DIR=
# 认证文件路径（可选，单文件调试或导入时覆盖使用）
AISTUDIO_AUTH_FILE=
# 临时文件目录（留空自动获取系统临时目录）
AISTUDIO_TMP_DIR=

# ========== 模型默认行为 ==========
AISTUDIO_DEFAULT_TEXT_MODEL=gemini-3.7-flash
AISTUDIO_DEFAULT_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ========== 超时与缓存控制 ==========
# 请求重放超时（秒）
AISTUDIO_TIMEOUT_REPLAY=120
# 流式传输响应超时（秒）
AISTUDIO_TIMEOUT_STREAM=120
# 模板捕获超时（秒）
AISTUDIO_TIMEOUT_CAPTURE=30
# BotGuard 签名快照缓存有效期（秒）
AISTUDIO_SNAPSHOT_CACHE_TTL=3600
# 快照缓存最大容量
AISTUDIO_SNAPSHOT_CACHE_MAX=100

# ========== 账号调度与重试 ==========
# 单请求最大故障转移重试次数
AISTUDIO_ACCOUNT_MAX_RETRIES=3

# ========== 调试输出 ==========
# 是否导出原始底层响应报文（1=开启，0=关闭）
AISTUDIO_DUMP_RAW_RESPONSE=0
# 原始报文导出目录
AISTUDIO_DUMP_RAW_RESPONSE_DIR=
